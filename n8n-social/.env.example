# ===== Copiar a .env (NO subir .env a git). Las credenciales de las APIs NO van acá: se cargan en n8n. =====

# Clave que cifra las credenciales guardadas en n8n. Generala una vez: openssl rand -hex 32
# Guardala en el gestor de contraseñas compartido: si se pierde, hay que reconectar todas las credenciales.
N8N_ENCRYPTION_KEY=

# ---- Modo prueba: cualquier valor distinto de "false" = NO publica (escribe PRUEBA OK en Error) ----
MODO_PRUEBA=true

# ---- Notion (ID de la base "Calendario de contenidos", 32 caracteres de la URL) ----
NOTION_DATABASE_ID=

# ---- Google Drive (carpeta compartida del equipo: Unidad compartida) ----
DRIVE_SHARED_DRIVE_ID=
DRIVE_ROOT_FOLDER_ID=        # ID de la carpeta "Contenido" dentro de la unidad compartida

# ---- LinkedIn ----
LINKEDIN_AUTHOR_URN=         # urn:li:person:XXXX  o  urn:li:organization:NNNN
LINKEDIN_API_VERSION=202603  # cabecera LinkedIn-Version (AAAAMM). Verificar versión vigente.

# ---- Instagram (cuenta profesional vinculada a una página de Facebook) ----
IG_USER_ID=                  # ID de la cuenta de Instagram (Graph API), no el @usuario
IG_PUBLIC_BUCKET=            # opcional: bucket público de Google Cloud Storage para el intento 2. Vacío = pasar a manual
