      "position": [
        7000,
        300
      ],
      "parameters": {
        "jsCode": "\nconst ctx = $('Preparar pieza y elegir plantilla').first().json;\nconst files = $input.all().map(i => i.json);\nconst designUrl = $('Verificar autofill y armar exportación').first().json.designUrl;\nconst archivo = ctx.plantilla.multi\n  ? 'https://drive.google.com/drive/folders/' + $('Carpeta destino (ID)').first().json.id\n  : 'https://drive.google.com/file/d/' + files[0].id + '/view';\nreturn [{ json: { pageId: ctx.pageId, archivo, enlaceCanva: designUrl } }];\n"
      }
    },
