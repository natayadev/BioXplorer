      ],
      "parameters": {
        "jsCode": "\nconst job = $json.job;\nif (job.status !== 'success') throw new Error('Canva exportación falló: ' + JSON.stringify(job.error || job).slice(0, 300));\nconst ctx = $('Preparar pieza y elegir plantilla').first().json;\nconst urls = job.urls || [];\nif (!urls.length) throw new Error('Canva no devolvió archivos exportados');\nconst ext = ctx.plantilla.fmt;\nreturn urls.map((u, i) => ({ json: { url: u, fileName: ctx.nombreBase + (urls.length > 1 ? '_p' + String(i + 1).padStart(2, '0') : '') + '.' + ext } }));\n"
