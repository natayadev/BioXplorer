      "name": "Registrar fallo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        470
      ],
      "parameters": {
        "jsCode": "\nconst ctx = $('Preparar pieza y elegir plantilla').first().json;\nconst e = $json.error;\nlet msg = typeof e === 'string' ? e : (e && (e.message || e.description)) || JSON.stringify($json).slice(0, 400);\nif (e && e.node && e.node.name) msg = '[' + e.node.name + '] ' + msg;\nconst m = (ctx.errorActual || '').match(/^ERROR \\(intento (\\d)\\/3\\)/);\nconst n = (m ? parseInt(m[1], 10) : 0) + 1;\nconst texto = (n >= 3 ? 'REINTENTOS AGOTADOS (3/3): ' : 'ERROR (intento ' + n + '/3): ') + msg;\nreturn [{ json: { pageId: ctx.pageId, texto: texto.slice(0, 1800) } }];\n"
      }
    },
