    {
      "id": "e863f20d-21f8-43ad-87d9-438c3726b3b1",
      "name": "Notion: buscar piezas aprobadas sin archivo",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        280,
        300
      ],
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "value": "={{ $env.NOTION_DATABASE_ID }}",
          "mode": "id"
        },
        "returnAll": false,
        "limit": 1,
        "simple": false,
        "filterType": "json",
        "filterJson": "={{ JSON.stringify({ and: [\n  { property: 'Estado', status: { equals: 'Aprobado' } },\n  { property: 'Archivo en Drive', url: { is_empty: true } },\n  { or: ['Carrusel', 'Post', 'Flyer', 'Story'].map(t => ({ property: 'Tipo', select: { equals: t } })) },\n  { or: [ { property: 'Error', rich_text: { is_empty: true } }, { property: 'Error', rich_text: { starts_with: 'ERROR (intento' } } ] }\n] }) }}",
        "options": {
          "sort": {
            "sortValue": [
              {
                "timestamp": false,
                "key": "Fecha de publicación|date",
                "direction": "ascending"
              }
            ]
          }
        }
      },
      "credentials": {
        "notionApi": {
          "id": "",
          "name": "Notion - Calendario de contenidos"
        }
      },
      "notes": "Estado=Aprobado, \"Archivo en Drive\" vacío, Tipo en Carrusel/Post/Flyer/Story y Error vacío (o reintento pendiente). Toma 1 pieza por corrida para evitar duplicados.",
      "notesInFlow": true
    },
    {
      "id": "c6f8d933-42be-4eb0-8477-ba39e97a8aca",
      "name": "Preparar pieza y elegir plantilla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "jsCode": "\n// ---- Utilidades (se repiten en cada nodo para que cada uno sea autosuficiente) ----\nconst TZ = 'America/Argentina/Buenos_Aires';\nconst txt = a => (a || []).map(t => t.plain_text).join('');\nconst sel = p => (p && (p.status || p.select)) ? (p.status || p.select).name : '';\nconst CALIDAD = ['Una idea y gancho', 'Fuente y permiso', 'Corregido otro día', 'Tamaño correcto'];\nfunction leer(page) {\n  const p = page.properties || {};\n  const fecha = p['Fecha de publicación'] && p['Fecha de publicación'].date ? p['Fecha de publicación'].date.start : '';\n  return {\n    pageId: page.id,\n    pageUrl: page.url,\n    titulo: txt(p['Contenido'] && p['Contenido'].title),\n    estado: sel(p['Estado']),\n    tipo: sel(p['Tipo']),\n    plataformas: ((p['Plataforma'] && p['Plataforma'].multi_select) || []).map(o => o.name),\n    fecha,\n    ganchoCopy: txt(p['Gancho y Copy'] && p['Gancho y Copy'].rich_text),\n    enlaceCanva: (p['Enlace Canva'] && p['Enlace Canva'].url) || '',\n    archivo: (p['Archivo en Drive'] && p['Archivo en Drive'].url) || '',\n    enlacePost: (p['Enlace del post'] && p['Enlace del post'].url) || '',\n    errorActual: txt(p['Error'] && p['Error'].rich_text),\n    calidad: CALIDAD.map(k => !!(p[k] && p[k].checkbox)),\n  };\n}\nconst slug = s => String(s).normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase()\n  .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 40).replace(/-+$/g, '') || 'sin-titulo';\nconst SOPORTADAS = ['Instagram', 'LinkedIn', 'X'];\n\n// ============ EDITAR: IDs de plantillas de marca de Canva (\"Brand template ID\") ============\n// Una plantilla por combinación Plataforma|Tipo, ya creada con el tamaño correcto.\n// Cada plantilla debe tener dos campos de texto de autofill: \"gancho\" y \"copy\".\nconst PLANTILLAS = {\n  'Instagram|Post':     { id: 'REEMPLAZAR_IG_POST',     w: 1080, h: 1350, fmt: 'jpg' },\n  'Instagram|Carrusel': { id: 'REEMPLAZAR_IG_CARRUSEL', w: 1080, h: 1350, fmt: 'jpg', multi: true },\n  'Instagram|Flyer':    { id: 'REEMPLAZAR_IG_FLYER',    w: 1080, h: 1350, fmt: 'jpg' },\n  'Instagram|Story':    { id: 'REEMPLAZAR_IG_STORY',    w: 1080, h: 1920, fmt: 'jpg' },\n  'LinkedIn|Carrusel':  { id: 'REEMPLAZAR_LI_CARRUSEL', w: 1080, h: 1350, fmt: 'pdf' },\n  'LinkedIn|Post':      { id: 'REEMPLAZAR_LI_POST',     w: 1200, h: 1200, fmt: 'jpg' },\n  'LinkedIn|Flyer':     { id: 'REEMPLAZAR_LI_FLYER',    w: 1200, h: 1200, fmt: 'jpg' },\n  'X|Post':             { id: 'REEMPLAZAR_X_POST',      w: 1200, h: 675,  fmt: 'jpg' },\n  'X|Flyer':            { id: 'REEMPLAZAR_X_FLYER',     w: 1200, h: 675,  fmt: 'jpg' },\n};\n// ===========================================================================================\n\nconst p = leer($input.first().json);\nconst bloquear = motivo => [{ json: { ...p, valido: false, motivo: 'BLOQUEADO: ' + motivo } }];\n\nconst plats = p.plataformas.filter(x => SOPORTADAS.includes(x));\nif (plats.length === 0) return bloquear('la pieza no tiene Instagram, LinkedIn ni X en Plataforma.');\nif (plats.length > 1) return bloquear('una pieza = una plataforma de diseño. Duplicá la fila (una por plataforma).');\nconst plataforma = plats[0];\nconst plantilla = PLANTILLAS[plataforma + '|' + p.tipo];\nif (!plantilla) return bloquear('no hay medida/plantilla definida para ' + plataforma + ' + ' + p.tipo + '.');\nif (plantilla.id.startsWith('REEMPLAZAR')) return bloquear('falta cargar el ID de plantilla de Canva para ' + plataforma + ' + ' + p.tipo + ' (editar en este nodo Code).');\n\nconst lineas = p.ganchoCopy.split(/\\r?\\n/).map(s => s.trim());\nconst gancho = lineas[0] || '';\nconst copy = lineas.slice(1).join('\\n').trim();\nif (!gancho || !copy) return bloquear('\"Gancho y Copy\" necesita gancho en la primera línea y copy debajo.');\n\nconst base = p.fecha ? DateTime.fromISO(p.fecha, { zone: TZ }) : DateTime.now().setZone(TZ);\nconst fechaTxt = base.toFormat('yyyy-LL-dd');\nconst nombreBase = fechaTxt + '_' + plataforma + '_' + p.tipo + '_' + slug(p.titulo);\n\nreturn [{ json: {\n  ...p, valido: true, plataforma, plantilla,\n  mes: base.toFormat('yyyy-LL'), nombreBase,\n  autofillBody: {\n    brand_template_id: plantilla.id,\n    title: nombreBase,\n    data: { gancho: { type: 'text', text: gancho }, copy: { type: 'text', text: copy } },\n  },\n} }];\n"
      }
    },
