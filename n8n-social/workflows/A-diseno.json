      ],
      "parameters": {
        "jsCode": "\nconst job = $json.job;\nif (job.status !== 'success') throw new Error('Canva autofill falló: ' + JSON.stringify(job.error || job).slice(0, 300));\nconst d = job.result.design;\nconst ctx = $('Preparar pieza y elegir plantilla').first().json;\nconst f = ctx.plantilla;\n// PDF para carruseles de LinkedIn; JPG con el tamaño de la tabla de medidas para el resto.\nconst format = f.fmt === 'pdf' ? { type: 'pdf' } : { type: 'jpg', quality: 92, width: f.w, height: f.h };\nreturn [{ json: { designId: d.id, designUrl: (d.urls && d.urls.edit_url) || d.url, exportBody: { design_id: d.id, format } } }];\n"
      },
      "onError": "continueErrorOutput"
    },
